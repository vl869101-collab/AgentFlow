{
  "name": "@agentflow/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript/JavaScript SDK for AgentFlow API & MCP Server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./generator": {
      "types": "./dist/generator/index.d.ts",
      "import": "./dist/generator/index.js",
      "default": "./dist/generator/index.js"
    }
  },
  "scripts": {
    "generate": "tsx scripts/generate-openapi.ts",
    "generate:check": "tsx scripts/generate-openapi.ts --check",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@agentflow/shared": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
