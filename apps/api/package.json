{
  "name": "@agentflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc",
    "test": "tsx --test test/backend.test.ts",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@agentflow/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.2",
    "@prisma/client": "^6.10.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.31.1",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "stripe": "^22.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.12.0",
    "prisma": "^6.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
