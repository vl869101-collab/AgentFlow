# ═══════════════════════════════════════════
# AgentFlow — Docker Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env and fill in real values

# ── Database ──────────────────────────────
DATABASE_URL="postgresql://agentflow:agentflow_dev@postgres:5432/agentflow?schema=public"

# ── Redis ─────────────────────────────────
REDIS_URL="redis://redis:6379"

# ── Auth ──────────────────────────────────
JWT_SECRET="change-me-to-a-random-secret-at-least-32-chars"

# ── AI (NVIDIA NIM) ───────────────────────
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# ── Stripe ────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_TEAM=""

# ── Frontend ──────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Backend ───────────────────────────────
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# ── Encryption ────────────────────────────
CREDENTIAL_ENCRYPTION_KEY="change-me-32-byte encryption key here!!"
