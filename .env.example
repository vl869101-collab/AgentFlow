# ═══════════════════════════════════════════
# AgentFlow — Environment Variables
# Copy to .env and fill in values
# ═══════════════════════════════════════════

# ── Database ──────────────────────────────
# Local: postgresql://agentflow:agentflow_dev@localhost:5432/agentflow?schema=public
# Docker: postgresql://agentflow:agentflow_dev@postgres:5432/agentflow?schema=public
DATABASE_URL=""

# ── Redis ─────────────────────────────────
# Local: redis://localhost:6379
# Docker: redis://redis:6379
REDIS_URL=""

# API listener defaults to loopback. Set HOST=0.0.0.0 only when a container or
# reverse proxy requires it, and set TRUST_PROXY to its trusted IP/CIDR list.
HOST="127.0.0.1"
TRUST_PROXY="false"

# ── Auth ──────────────────────────────────
# Generate: openssl rand -hex 32 (MUST be at least 32 characters)
JWT_SECRET=""
JWT_EXPIRES_IN="15m"
REFRESH_EXPIRES_IN="7d"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ── AI (NVIDIA NIM) ───────────────────────
# Get key: https://build.nvidia.com → API Catalog → Generate API Key
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_NIM_API_KEY=""
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"

# ── Stripe ────────────────────────────────
# Get keys: https://dashboard.stripe.com → Developers → API keys
# Get webhook secret: stripe listen --forward-to localhost:3001/api/billing/webhook
# Get price IDs: Dashboard → Products → Create product + price
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""

# ── Frontend ──────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Backend ───────────────────────────────
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# ── Encryption ────────────────────────────
# Generate: openssl rand -hex 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Must be exactly 64 hex chars (32 bytes). No default — API refuses to boot without a valid key.
CREDENTIAL_ENCRYPTION_KEY=""

# ── OAuth (Social Login) ─────────────────
# Google: https://console.cloud.google.com → APIs & Services → Credentials
# Create OAuth 2.0 Client ID → Authorized redirect URIs: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft: https://portal.azure.com → Azure Active Directory → App registrations
# Create registration → Redirect URI: http://localhost:3001/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Apple: https://developer.apple.com → Certificates, Identifiers & Profiles → Identifiers
# Create App ID with Sign In with Apple → Service ID for web
# Create private key for Sign In with Apple
APPLE_CLIENT_ID=""  # Service ID (e.g., com.example.service)
APPLE_TEAM_ID=""    # Team ID from Apple Developer account
APPLE_KEY_ID=""     # Key ID from the private key
APPLE_PRIVATE_KEY=""  # Private key content (-----BEGIN PRIVATE KEY-----...)
