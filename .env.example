# ═══════════════════════════════════════════
# AgentFlow — Environment Variables
# Copy to .env and fill in values:  cp .env.example .env
# Required to boot the API: DATABASE_URL, JWT_SECRET, CREDENTIAL_ENCRYPTION_KEY
# ═══════════════════════════════════════════

# ── Core / Server ─────────────────────────
NODE_ENV="development"          # development | test | production
PORT=3001                       # API port
CORS_ORIGIN="http://localhost:3000"  # Web origin allowed to call the API

# API listener defaults to loopback. Set HOST=0.0.0.0 only when a container or
# reverse proxy requires it, and set TRUST_PROXY to its trusted IP/CIDR list.
HOST="127.0.0.1"
TRUST_PROXY="false"

# ── Database (required) ──────────────────
# Local: postgresql://agentflow:agentflow_dev@localhost:5432/agentflow?schema=public
# Docker: postgresql://agentflow:agentflow_dev@postgres:5432/agentflow?schema=public
DATABASE_URL=""

# ── Redis / Queue (optional) ─────────────
# BullMQ queue for background executions. Falls back to in-process execution
# when Redis is absent. Set QUEUE_ENABLED=true to force the queue even outside
# production (it is always on when NODE_ENV=production).
REDIS_URL="redis://localhost:6379"
QUEUE_ENABLED=""

# ── Auth (required) ──────────────────────
# Generate: openssl rand -hex 32 (MUST be at least 32 characters)
JWT_SECRET=""
JWT_EXPIRES_IN="15m"            # access token TTL
REFRESH_EXPIRES_IN="7d"         # refresh token TTL

# ── Encryption (required) ────────────────
# AES-256-GCM key for stored credentials.
# Generate: openssl rand -hex 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Must be exactly 64 hex chars (32 bytes). No default — API refuses to boot without a valid key.
CREDENTIAL_ENCRYPTION_KEY=""

# ── AI (NVIDIA NIM — used by POST /api/ai/generate) ──
# Get key: https://build.nvidia.com → API Catalog → Generate API Key
NVIDIA_NIM_API_KEY=""
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"

# Reserved for upcoming providers — not read by the API yet.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ── Stripe (optional — billing) ──────────
# Get keys: https://dashboard.stripe.com → Developers → API keys
# Get webhook secret: stripe listen --forward-to localhost:3001/api/billing/webhook
# Get price IDs: Dashboard → Products → Create product + price
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_TEAM=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── Frontend (web) ───────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"   # where the web app finds the API
NEXT_PUBLIC_APP_URL="http://localhost:3000"   # public URL of the web app (OAuth/billing redirects)

# ── OAuth (social login, optional) ───────
# Google: https://console.cloud.google.com → APIs & Services → Credentials
# Create OAuth 2.0 Client ID → Authorized redirect URIs: ${NEXT_PUBLIC_API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft: https://portal.azure.com → Azure Active Directory → App registrations
# Create registration → Redirect URI: ${NEXT_PUBLIC_API_URL}/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Apple: https://developer.apple.com → Certificates, Identifiers & Profiles → Identifiers
# Create App ID with Sign In with Apple → Service ID for web → private key
APPLE_CLIENT_ID=""      # Service ID (e.g., com.example.service)
APPLE_TEAM_ID=""        # Team ID from Apple Developer account (used to mint the client secret)
APPLE_KEY_ID=""         # Key ID from the private key (used to mint the client secret)
APPLE_PRIVATE_KEY=""    # Private key content (-----BEGIN PRIVATE KEY-----...)
